{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-frame-animation/job.schema.json",
  "title": "AI frame animation job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "character", "motion", "delivery", "provider"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "job_id": {"type": "string", "minLength": 1},
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "continuity"],
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "continuity": {"enum": ["loop", "one_shot"]}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "atlas_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["4x4", "8x4", "8x8"]}
        },
        "frame_counts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": [16, 32, 64]}
        },
        "size": {"enum": [128, 256, 512]},
        "quality": {"enum": ["strict", "best_effort"], "default": "strict"},
        "gif": {"type": "boolean", "default": true},
        "key_color": {
          "enum": ["auto", "#FF0000", "#FF8000", "#FFFF00", "#80FF00", "#00FF00", "#00FF80", "#00FFFF", "#0080FF", "#0000FF", "#8000FF", "#FF00FF", "#FF0080"],
          "default": "auto"
        }
      },
      "oneOf": [
        {"required": ["atlas_profiles"], "not": {"required": ["frame_counts"]}},
        {"required": ["frame_counts"], "not": {"required": ["atlas_profiles"]}}
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin"],
      "properties": {"plugin": {"type": "string", "minLength": 1}}
    },
    "intent_compilation": {"$ref": "#/$defs/intentCompilation"}
  },
  "$defs": {
    "intentCompilation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "compiler_version", "intent_sha256", "prompt_sha256", "reference", "checks", "compilation_sha256"],
      "properties": {
        "schema_version": {"const": "ai_frame_animation_intent_compilation_v1"},
        "compiler_version": {"const": "ai_frame_animation_intent_compiler_v1"},
        "intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compilation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference": {
          "type": "object", "additionalProperties": false,
          "required": ["source_sha256", "foreground_sha256", "preparation_sha256"],
          "properties": {
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "foreground_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "preparation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"properties": {"delivery": {"required": ["atlas_profiles"], "not": {"required": ["frame_counts"]}}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}},
      "then": {"properties": {"delivery": {"required": ["frame_counts"], "not": {"required": ["atlas_profiles"]}}}}
    }
  ]
}
