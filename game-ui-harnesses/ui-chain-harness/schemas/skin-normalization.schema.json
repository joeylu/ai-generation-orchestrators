{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-skin-normalization-policy",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "revision", "detection", "resampling", "scope"],
  "properties": {
    "kind": { "const": "ui_skin_normalization_policy" },
    "version": { "const": "0.1" },
    "revision": { "type": "integer", "minimum": 1 },
    "scope": { "const": "review-candidates-only" },
    "refinement": {
      "type":"object", "additionalProperties":false, "required":["states","edgeColor"],
      "properties": {
        "smoothEnvelope": {
          "type":"object", "additionalProperties":false,
          "required":["enabled","coreAlpha","paddingPixels","featherPixels","maxRemovedAlphaMassFraction"],
          "properties": {
            "enabled":{"type":"boolean"},"coreAlpha":{"type":"integer","minimum":64,"maximum":224},
            "paddingPixels":{"type":"number","minimum":0,"maximum":2},
            "insetPixels":{"type":"number","minimum":0,"maximum":1},
            "featherPixels":{"type":"number","minimum":0.5,"maximum":2},
            "maxRemovedAlphaMassFraction":{"type":"number","minimum":0,"maximum":0.05}
          }
        },
        "states": {
          "type":"object", "additionalProperties":false,
          "required":["enabled","coreAlpha","maxAxisScaleChange","maxRemovedAlphaMassFraction"],
          "properties": {
            "enabled":{"type":"boolean"},"coreAlpha":{"type":"integer","minimum":64,"maximum":254},
            "maxAxisScaleChange":{"type":"number","minimum":1,"maximum":1.25},
            "maxRemovedAlphaMassFraction":{"type":"number","minimum":0,"maximum":0.1}
          }
        },
        "edgeColor": {
          "type":"object", "additionalProperties":false,
          "required":["enabled","coreAlpha","bandPixels","searchRadius","minSaturation","hueRanges","maxChangedPixelFraction","maxUnresolvedPixels"],
          "properties": {
            "enabled":{"type":"boolean"},"coreAlpha":{"type":"integer","minimum":64,"maximum":254},
            "bandPixels":{"type":"integer","minimum":1,"maximum":4},"searchRadius":{"type":"integer","minimum":2,"maximum":12},
            "minSaturation":{"type":"number","minimum":0.5,"maximum":1},
            "hueRanges":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0,"maximum":360}}},
            "maxChangedPixelFraction":{"type":"number","minimum":0,"maximum":0.05},
            "maxUnresolvedPixels":{"type":"integer","minimum":0,"maximum":64}
          }
        }
      }
    },
    "detection": {
      "type": "object", "additionalProperties": false,
      "required": ["seedAlpha", "minimumCorePixels", "maxDiscardedAlphaMassFraction", "minExtentRatio", "maxExtentRatio", "maxCanvasAspectRatioDrift"],
      "properties": {
        "seedAlpha": { "type": "integer", "minimum": 1, "maximum": 255 },
        "minimumCorePixels": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxDiscardedAlphaMassFraction": { "type": "number", "minimum": 0, "maximum": 0.02 },
        "minExtentRatio": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "maxExtentRatio": { "type": "number", "minimum": 1, "maximum": 4 },
        "maxCanvasAspectRatioDrift": { "type": "number", "minimum": 1, "maximum": 1.2 }
      }
    },
    "resampling": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "uniform", "capsules", "maxUniformAspectRatioDrift", "maxUpscale"],
      "properties": {
        "method": { "const": "premultiplied-area-srgb" },
        "uniform": { "const": "contain-centered" },
        "capsules": { "const": "preserve-endcaps" },
        "maxUniformAspectRatioDrift": { "type": "number", "minimum": 1, "maximum": 1.3 },
        "maxUpscale": { "type": "number", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
