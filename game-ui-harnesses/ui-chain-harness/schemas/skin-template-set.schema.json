{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ui-chain:skin-template-set:0.2",
  "title": "UI skin template authoring draft v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "version", "revision", "status", "purpose", "coordinates", "constraints", "palette", "reviewFont", "consumerTypes", "stateGroups", "sheets"],
  "properties": {
    "$schema": {"type": "string"},
    "kind": {"const": "ui_skin_template_set_draft"},
    "version": {"const": "0.2"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "discussion-draft"},
    "purpose": {"$ref": "#/definitions/label"},
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "origin", "width", "height", "outputScale"],
      "properties": {
        "unit": {"const": "logical-pixel"}, "origin": {"const": "top-left"},
        "width": {"type": "integer", "minimum": 128, "maximum": 4096},
        "height": {"type": "integer", "minimum": 128, "maximum": 4096},
        "outputScale": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumOuterMargin", "minimumSlotGap", "minimumBodyPadding", "cleanContainsText", "functionalIcons"],
      "properties": {
        "minimumOuterMargin": {"type": "integer", "minimum": 0},
        "minimumSlotGap": {"type": "integer", "minimum": 0},
        "minimumBodyPadding": {"type": "integer", "minimum": 0},
        "cleanContainsText": {"const": false}, "functionalIcons": {"const": false}
      }
    },
    "palette": {
      "type": "object", "additionalProperties": {"$ref": "#/definitions/color"},
      "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"},
      "required": ["stroke", "reviewBackground", "reviewSlot", "reviewText", "reviewMuted", "reviewPending"],
      "properties": {
        "stroke": {"$ref": "#/definitions/color"}, "reviewBackground": {"$ref": "#/definitions/color"},
        "reviewSlot": {"$ref": "#/definitions/color"}, "reviewText": {"$ref": "#/definitions/color"},
        "reviewMuted": {"$ref": "#/definitions/color"}, "reviewPending": {"$ref": "#/definitions/color"}
      }
    },
    "reviewFont": {
      "type": "object", "additionalProperties": false, "required": ["family", "size"],
      "properties": {
        "family": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/label"}},
        "size": {"type": "integer", "minimum": 8, "maximum": 64}
      }
    },
    "consumerTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "stateGroups": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "assetIds"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "assetIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
        }
      }
    },
    "sheets": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "filePrefix", "title", "parts"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "filePrefix": {"type": "string", "pattern": "^s[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
          "title": {"$ref": "#/definitions/label"},
          "parts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/definitions/part"}}
        }
      }
    }
  },
  "definitions": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 96},
    "label": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
    "insets": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/rect"}]},
    "primitive": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "radius"], "properties": {"type": {"const": "roundRect"}, "radius": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["circle", "ring"]}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "points"], "properties": {
          "type": {"const": "polygon"}, "points": {"type": "array", "minItems": 3, "maxItems": 128, "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}}}
        }}
      ]
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "assetId", "label", "consumers", "state", "slotRect", "bodyRect", "primitive", "paint", "strokeWidth", "stretch", "productionPolicy", "contentInsets", "sliceInsets"],
      "properties": {
        "code": {"$ref": "#/definitions/id"}, "assetId": {"$ref": "#/definitions/id"}, "label": {"$ref": "#/definitions/label"},
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "state": {"$ref": "#/definitions/id"}, "slotRect": {"$ref": "#/definitions/rect"}, "bodyRect": {"$ref": "#/definitions/rect"},
        "primitive": {"$ref": "#/definitions/primitive"}, "paint": {"$ref": "#/definitions/id"},
        "strokeWidth": {"type": "number", "minimum": 0},
        "stretch": {"enum": ["nine-slice", "horizontal", "vertical", "uniform"]},
        "productionPolicy": {"enum": ["raster-candidate", "raster-or-procedural-undecided"]},
        "contentInsets": {"$ref": "#/definitions/insets"}, "sliceInsets": {"$ref": "#/definitions/insets"}
      }
    }
  }
}
