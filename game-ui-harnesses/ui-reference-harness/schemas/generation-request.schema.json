{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-game-assets:ui-reference:generation-request:2",
  "$comment": "Only the deterministic compiler authors this document. width/height are logical canvas dimensions. maximumCalls=0 denotes a raw-reuse plan that must never dispatch to an image provider. Runtime reconstructs prompt, policy and image order.",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "prompt", "images", "width", "height", "resolution", "output", "maximumCalls"],
  "properties": {
    "kind": { "const": "ui_reference_generation_request_v2" }, "prompt": { "type": "string", "minLength": 1 },
    "images": { "type": "array", "minItems": 1, "maxItems": 6, "items": {
      "type": "object", "additionalProperties": false, "required": ["role", "artifact"],
      "properties": {
        "role": { "enum": ["correction-source", "layout-reference", "primary-style", "preset-palette-guide", "accepted-project-anchor", "original-prototype-context"] },
        "artifact": { "$ref": "urn:ai-game-assets:ui-reference:common:1#/$defs/artifact" }
      }
    } },
    "width": { "type": "integer", "minimum": 1, "maximum": 4096 }, "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "resolution": { "$ref": "urn:ai-game-assets:ui-reference:resolution:1" },
    "output": { "type": "object", "additionalProperties": false, "required": ["format", "opaque"], "properties": { "format": { "const": "png" }, "opaque": { "const": true } } },
    "maximumCalls": { "enum": [0, 1] }
  }
}
