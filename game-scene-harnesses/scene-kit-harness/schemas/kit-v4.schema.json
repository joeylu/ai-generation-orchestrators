{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_scene_kit_v4",
  "type": "object",
  "properties": {
    "format": {
      "const": "ai_scene_kit_v4"
    },
    "kitId": {
      "$ref": "kit.schema.json#/properties/kitId"
    },
    "revision": {
      "$ref": "kit.schema.json#/properties/revision"
    },
    "profile": {
      "$ref": "kit.schema.json#/properties/profile"
    },
    "purpose": {
      "const": "art-candidate"
    },
    "grid": {
      "$ref": "kit.schema.json#/properties/grid"
    },
    "pixelsPerUnit": {
      "$ref": "kit.schema.json#/properties/pixelsPerUnit"
    },
    "files": {
      "$ref": "kit.schema.json#/properties/files"
    },
    "terrainEdges": { "$ref": "#/$defs/terrainEdges" },
    "terrainSharedField": { "$ref": "shared-terrain-field.schema.json" },
    "terrainBottomEdges": { "$ref": "terrain-bottom-edges-compatible.schema.json" },
    "terrainMaterialLoop": { "$ref": "terrain-material-loop.schema.json" },
    "terrainSurfaceCycle": { "$ref": "terrain-surface-cycle.schema.json" },
    "terrainSurfaceSpanEnvelope": { "$ref": "terrain-surface-span-envelope.schema.json" },
    "terrainStepSurface": { "$ref": "terrain-step-surface.schema.json" },
    "terrainRigidRepeat": { "$ref": "terrain-rigid-repeat.schema.json" },
    "terrainStepCorners":{"type":"object","properties":{"format":{"const":"ai_scene_terrain_step_corners_v1"},"profile":{"const":"concave-source-surface-ramp-v1"},"widthWorld":{"type":"number","minimum":8,"maximum":48},"heightWorld":{"type":"number","minimum":4,"maximum":24},"segments":{"const":16}},"required":["format","profile","widthWorld","heightWorld","segments"],"additionalProperties":false},
    "terrainAppearance": {
      "type": "object",
      "properties": {
        "format": {
          "enum": ["ai_scene_continuous_terrain_appearance_v2", "ai_scene_continuous_terrain_appearance_v3", "ai_scene_continuous_terrain_appearance_v4", "ai_scene_continuous_terrain_appearance_v5", "ai_scene_continuous_terrain_appearance_v6"]
        },
        "selection": {
          "const": "world-cell-8x4-phase-order-v1"
        },
        "profileSha256": {
          "enum": ["eea16fad6eb3530f9a9586877bf9c9aace07137d5f893f75a6218eb09a4b51dd", "c0ffe5b2bb0aaa758ceacb1feff8da5261bf93a34fd1db77e4d7c788d0a6d729", "55151a08adb6cd413f087fe71626cd06f2bb7f26310aeaa5af6a3c1fddbde28e", "09178d9ba9848359c51be0522002fbf97c6c594c21d9a6b5afd257df9148e326", "64c78ea9f54a05d56d73bbbdacab8fa5eda2b23e8a4c048a3a9d6685db53dc1f"]
        },
        "sourceSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "studySha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "body": {
          "$ref": "#/$defs/material"
        },
        "cap": {
          "$ref": "#/$defs/material"
        },
        "surfaceOriginInBodyPixels": {
          "type": "object",
          "properties": {
            "numerator": { "type": "integer", "minimum": -9007199254740991, "maximum": 0 },
            "denominator": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          },
          "required": ["numerator", "denominator"],
          "additionalProperties": false
        },
        "surfaceMappingSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "capDepth": { "$ref": "#/$defs/positiveRational" },
        "capUvEnd": { "$ref": "#/$defs/positiveRational" },
        "visualAcceptance": {
          "const": "not-assessed"
        },
        "tint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        }
      },
      "required": [
        "format",
        "selection",
        "profileSha256",
        "sourceSha256",
        "studySha256",
        "body",
        "cap",
        "visualAcceptance"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "terrainEdges": {
      "type": "object",
      "properties": {
        "format": { "enum": ["ai_scene_terrain_edges_v1", "ai_scene_terrain_edges_v2", "ai_scene_terrain_edges_v3", "ai_scene_terrain_edges_v4", "ai_scene_terrain_edges_v5", "ai_scene_terrain_edges_v6"] },
        "profile": { "const": "curve-vertical-exposed-native-v1" },
        "joinProfile": { "const": "native-near-opaque-underlap-v1" },
        "gridProfile": { "const": "grid-solid-union-native-v1" },
        "junctions": { "$ref": "#/$defs/edgeJunctions" },
        "materialProfile": { "const": "union-world-body-local-surface-v1" },
        "sideTerminationProfile": { "const": "exposed-side-only-v1" },
        "surfaceInterface": {
          "type": "object",
          "properties": {
            "profile": { "const": "world-body-native-lip-v1" },
            "capSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
            "capEndRow": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "fadeRows": { "type": "integer", "minimum": 0, "maximum": 4096 }
          },
          "required": ["profile", "capSourceSha256", "capEndRow", "fadeRows"], "additionalProperties": false
        },
        "sourceBinding": {
          "type": "object",
          "properties": {
            "materialSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
            "surfaceMappingSha256": { "$ref": "common.schema.json#/$defs/sha256" }
          },
          "required": ["materialSourceSha256", "surfaceMappingSha256"], "additionalProperties": false
        },
        "left": { "$ref": "#/$defs/edgeSide" },
        "right": { "$ref": "#/$defs/edgeSide" }
      },
      "required": ["format", "profile", "sourceBinding", "left", "right"], "additionalProperties": false
    },
    "edgeJunctions": {
      "type": "object",
      "properties": {
        "format": { "const": "ai_scene_terrain_edge_junctions_v1" },
        "profile": { "enum": ["native-alpha-complete-overlap-v1", "native-alpha-repeat-window-v1"] },
        "algorithm": { "const": "complete-source-over-bottom-to-top-v1" },
        "maxTailAfterAnchorWorld": { "const": 80 },
        "maximumOverlapLayers": { "const": 8 },
        "sourceInputs": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "key": { "enum": ["left.wall", "left.corner", "right.wall", "right.corner"] },
              "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
              "pixelSize": { "$ref": "common.schema.json#/$defs/size" },
              "controlsSha256": { "$ref": "common.schema.json#/$defs/sha256" }
            },
            "required": ["key", "sha256", "pixelSize", "controlsSha256"], "additionalProperties": false
          }
        },
        "left": { "$ref": "#/$defs/edgeJunctionSide" },
        "right": { "$ref": "#/$defs/edgeJunctionSide" },
        "coverage": { "const": "native-alpha-source-over-overlap" },
        "sourcePngChanged": { "const": false },
        "visualAcceptance": { "const": "not-assessed" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "required": ["format", "profile", "algorithm", "maxTailAfterAnchorWorld", "maximumOverlapLayers", "sourceInputs", "left", "right", "coverage", "sourcePngChanged", "visualAcceptance", "sha256"],
      "additionalProperties": false
    },
    "edgeJunctionSide": {
      "type": "object",
      "properties": {
        "cornerWall": {
          "type": "object",
          "properties": {
            "mode": { "const": "natural-alpha-tail" },
            "source": { "enum": ["left.corner", "right.corner"] },
            "nativeFromY": { "const": 0 },
            "nativeToY": { "type": "integer", "minimum": 4, "maximum": 4096 },
            "tailAfterAnchorWorld": { "type": "number", "minimum": 0, "maximum": 80 },
            "firstWallNativeOriginWorld": { "type": "number", "minimum": -4224, "maximum": 128 },
            "drawOrder": { "const": "complete-corner-after-walls" }
          },
          "required": ["mode", "source", "nativeFromY", "nativeToY", "tailAfterAnchorWorld", "firstWallNativeOriginWorld", "drawOrder"], "additionalProperties": false
        },
        "wallRepeat": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["natural-alpha-complete-overlap", "native-repeat-window"] },
            "source": { "enum": ["left.wall", "right.wall"] },
            "nativeFromY": { "type": "integer", "minimum": 0, "maximum": 4094 },
            "nativeToY": { "type": "integer", "minimum": 2, "maximum": 4096 },
            "stepWorld": { "type": "number", "minimum": 0, "maximum": 4096 },
            "sourceHeightWorld": { "type": "number", "minimum": 0, "maximum": 4096 },
            "overlapWorld": { "type": "number", "minimum": 0, "maximum": 4096 },
            "drawOrder": { "const": "lower-walls-before-upper-walls" }
          },
          "required": ["mode", "source", "nativeFromY", "nativeToY", "stepWorld", "sourceHeightWorld", "overlapWorld", "drawOrder"], "additionalProperties": false
        },
        "support": {
          "type": "object",
          "properties": {
            "minimumNativeCompositeAlpha": { "type": "number", "minimum": 250, "maximum": 255 },
            "sampleStepWorld": { "type": "number", "minimum": 0, "maximum": 1 },
            "fromWorld": { "const": 0 },
            "toWorld": { "type": "number", "minimum": 1, "maximum": 32768 },
            "collarWorldOffsets": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -128, "maximum": 128 } },
            "coverage": { "const": "original-alpha-source-over-before-inboard-coverage" }
          },
          "required": ["minimumNativeCompositeAlpha", "sampleStepWorld", "fromWorld", "toWorld", "collarWorldOffsets", "coverage"], "additionalProperties": false
        }
      },
      "required": ["cornerWall", "wallRepeat", "support"], "additionalProperties": false
    },
    "edgeSide": {
      "type": "object",
      "properties": { "wall": { "$ref": "#/$defs/edgeWall" }, "corner": { "$ref": "#/$defs/edgeCorner" } },
      "required": ["wall", "corner"], "additionalProperties": false
    },
    "edgeWall": {
      "type": "object",
      "properties": {
        "source": { "$ref": "module-catalog.schema.json#/properties/modules/items/properties/source" },
        "pixelSize": { "$ref": "common.schema.json#/$defs/size" },
        "scale": { "$ref": "#/$defs/positiveRational" },
        "boundaryX": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "innerX": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "inboardBlend": { "$ref": "#/$defs/inboardBlend" },
        "repeatY": {
          "type": "object", "properties": { "from": { "type": "integer", "minimum": 0, "maximum": 4094 }, "to": { "type": "integer", "minimum": 2, "maximum": 4096 } },
          "required": ["from", "to"], "additionalProperties": false
        }
      },
      "required": ["source", "pixelSize", "scale", "boundaryX", "innerX", "repeatY"], "additionalProperties": false
    },
    "edgeCorner": {
      "type": "object",
      "properties": {
        "source": { "$ref": "module-catalog.schema.json#/properties/modules/items/properties/source" },
        "pixelSize": { "$ref": "common.schema.json#/$defs/size" },
        "scale": { "$ref": "#/$defs/positiveRational" },
        "boundaryX": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "innerX": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "inboardBlend": { "$ref": "#/$defs/inboardBlend" },
        "surfaceY": { "type": "integer", "minimum": 0, "maximum": 4094 },
        "wallStartY": { "type": "integer", "minimum": 2, "maximum": 4096 }
      },
      "required": ["source", "pixelSize", "scale", "boundaryX", "innerX", "surfaceY", "wallStartY"], "additionalProperties": false
    },
    "inboardBlend": {
      "type": "object", "properties": { "fromX": { "type": "integer", "minimum": 0, "maximum": 4096 }, "toX": { "type": "integer", "minimum": 0, "maximum": 4096 } },
      "required": ["fromX", "toX"], "additionalProperties": false
    },
    "positiveRational": {
      "type": "object",
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["numerator", "denominator"],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "module-catalog.schema.json#/properties/modules/items/properties/source"
        },
        "pixelSize": {
          "$ref": "common.schema.json#/$defs/size"
        }
      },
      "required": [
        "source",
        "pixelSize"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "kitId",
    "revision",
    "profile",
    "purpose",
    "grid",
    "pixelsPerUnit",
    "files",
    "terrainAppearance"
  ],
  "additionalProperties": false
}
