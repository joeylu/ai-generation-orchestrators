{
  "name": "ai-ui-component-harness",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "self-test": "node scripts/cli.mjs self-test",
    "doctor": "node scripts/cli.mjs doctor",
    "verify": "node scripts/verify.mjs",
    "fixtures": "node scripts/write-fixtures.mjs",
    "motion:fixtures": "node scripts/write-motion-systems.mjs"
  },
  "bin": {
    "ai-ui-component": "scripts/cli.mjs",
    "ai-ui-motion": "scripts/motion-cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "scripts/cli.mjs",
    "scripts/reference-run.mjs",
    "dist/reference-acceptance.html",
    "dist/assets",
    "scripts/motion-cli.mjs",
    "scripts/workflow-run.mjs",
    "scripts/workflow-browser.mjs",
    "scripts/legacy-layered-import.mjs",
    "scripts/legacy-layered-case.mjs",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "skill.json",
    "agents",
    "skills",
    "docs/automation.md",
    "docs/reference-consumer-v2.md",
    "docs/decomposition-appearance.md",
    "docs/list-background-v1.md",
    "docs/list-background-v1.schema.json",
    "docs/examples/list-background-v1.binding.json",
    "docs/select-menu-highlights-v1.md",
    "docs/button-label-lines-v1.md",
    "docs/tabs-background-v1.md",
    "docs/value-text-bindings-v1.md",
    "docs/component-linkages-v1.md",
    "docs/examples/list-item-contents-v1.document.json",
    "docs/scrollbar-thumb-slices-v1.md",
    "docs/legacy-layered-case.md",
    "docs/motion.md",
    "docs/release-v0.2.0-rc.1.md",
    "docs/runtime.md",
    "docs/workflow.md",
    "prompts",
    "examples/button.json",
    "examples/motion-system-catalog.json",
    "examples/motion-system-corporate.json",
    "examples/motion-system-corporate.request.json",
    "examples/motion-system-playful.json",
    "examples/motion-system-playful.request.json",
    "examples/motion-system-premium.json",
    "examples/motion-system-premium.request.json",
    "examples/preview-policy.json",
    "examples/programmatic-composite.document.json",
    "examples/programmatic-composite.facts.json",
    "examples/programmatic-composite.intent.json",
    "examples/programmatic-composite.motion.json",
    "examples/programmatic-composite.policy.json",
    "examples/programmatic-gallery.document.json",
    "examples/programmatic-gallery.facts.json",
    "examples/programmatic-gallery.intent.json",
    "examples/programmatic-gallery.motion.json",
    "examples/programmatic-gallery.policy.json",
    "public/fixtures/button.svg",
    "public/fixtures/gem.svg",
    "public/fixtures/plate.svg"
  ],
  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}


