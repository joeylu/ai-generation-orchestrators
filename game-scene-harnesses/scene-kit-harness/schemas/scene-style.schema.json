{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene style revision v1",
  "type": "object",
  "properties": {
    "format": { "const": "ai_scene_style_v1" },
    "styleId": { "$ref": "common.schema.json#/$defs/id" },
    "mode": { "enum": ["preset", "custom"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "rules": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "generation-common.schema.json#/$defs/rule" } },
    "anchors": { "type": "array", "maxItems": 1, "items": { "$ref": "generation-common.schema.json#/$defs/image" } }
  },
  "required": ["format", "styleId", "mode", "name", "rules", "anchors"],
  "additionalProperties": false
}
