{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit source-owned appearance rules",
  "type": "object",
  "properties": {
    "format": { "const": "ai_scene_source_appearance_v1" },
    "profile": { "const": "source-owned-appearance-v1" },
    "promptProfile": { "const": "reference-atmosphere-v1" },
    "rules": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "generation-common.schema.json#/$defs/rule" } }
  },
  "required": ["format", "profile", "rules"],
  "additionalProperties": false
}
