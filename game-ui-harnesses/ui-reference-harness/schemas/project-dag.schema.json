{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-game-assets:ui-reference:project-dag:1",
  "$comment": "Immutable project-local DAG definition. The runtime verifies topology, acyclicity, source blobs, accepted evidence and operation bindings; this schema alone is not acceptance or compute authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "projectId", "runtimeSha256", "styleSha256", "selection", "resolution", "anchorPanelId", "initialAnchor", "maximumRevisions", "panels", "nodes", "sha256"],
  "properties": {
    "kind": { "const": "ui_reference_project_dag_v1" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "projectId": { "$ref": "#/$defs/id" },
    "runtimeSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "styleSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "selection": { "enum": ["all-registered", "explicit-subset"] },
    "resolution": { "enum": ["native", "exact"] },
    "anchorPanelId": { "$ref": "#/$defs/id" },
    "initialAnchor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["panelId", "run", "planSha256", "reviewSha256", "imageSha256"],
          "properties": {
            "panelId": { "$ref": "#/$defs/id" },
            "run": { "$ref": "#/$defs/run" },
            "planSha256": { "$ref": "common.schema.json#/$defs/sha256" },
            "reviewSha256": { "$ref": "common.schema.json#/$defs/sha256" },
            "imageSha256": { "$ref": "common.schema.json#/$defs/sha256" }
          }
        }
      ]
    },
    "maximumRevisions": { "const": 3 },
    "panels": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["panelId", "prototype", "intent", "adoptedRun"],
        "properties": {
          "panelId": { "$ref": "#/$defs/id" },
          "prototype": { "$ref": "common.schema.json#/$defs/artifact" },
          "intent": { "$ref": "intent.schema.json" },
          "adoptedRun": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/run" }] }
        }
      }
    },
    "nodes": {
      "type": "array", "minItems": 10, "maxItems": 451,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "panelId", "dependsOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["frozen-project-inputs", "plan", "generation", "raw-qa", "post-process", "post-qa", "visual-review", "accepted-selection", "accepted-project-anchor", "verified-project-delivery"] },
          "panelId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
          "dependsOn": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "run": { "type": "string", "pattern": "^runs/[a-f0-9-]{36}$" }
  }
}
