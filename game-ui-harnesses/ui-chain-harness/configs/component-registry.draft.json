{
  "$schema": "../schemas/component-registry.schema.json",
  "kind": "ui_component_registry_draft",
  "version": "0.1",
  "revision": 4,
  "commonProps": {
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "quantization": {
    "endpoint": "max-is-explicit-valid-endpoint",
    "relativeTolerance": 1e-9
  },
  "acceptanceCases": [
    {
      "id": "G01",
      "title": "文档合同",
      "scope": "common",
      "procedure": "未知字段/类型/版本、重复 ID、悬空资源/槽引用、非法数值均定位到字段并阻断；有效默认值从唯一声明解析",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P1",
      "componentType": null
    },
    {
      "id": "G02",
      "title": "皮肤与尺寸",
      "scope": "common",
      "procedure": "在最小、常规、加宽/加高盒子中核对部件、内容区域、命中范围；非法小尺寸明确报错；带文字的组件验证长中文、空串及混排",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P1",
      "componentType": null
    },
    {
      "id": "G03",
      "title": "交互隔离",
      "scope": "common",
      "procedure": "用户手势产生规定次数的事件；初始化/恢复/程序更新不冒充用户事件；禁用/隐藏/编辑模式不触发业务操作",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P1 / P2",
      "componentType": null
    },
    {
      "id": "G04",
      "title": "资源与销毁",
      "scope": "common",
      "procedure": "两个实例共享资源，销毁一个不破坏另一个；重复挂载/销毁后无重复订阅、残留输入 DOM、浮层或自有 ticker",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P1",
      "componentType": null
    },
    {
      "id": "G05",
      "title": "真实往返",
      "scope": "common",
      "procedure": "由创作文档创建 → 用户交互 → 保存创作文档 → 重开；创作值/稳定 ID/配置不受试玩污染；资源重新解析后输出一致",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P2",
      "componentType": null
    },
    {
      "id": "G06",
      "title": "画布事务",
      "scope": "common",
      "procedure": "每种支持的属性修改、槽位操作、尺寸/排序/合法自由定位都可撤销/重做；失败回滚；16:9 与 9:16 均无越界或不可操作控件",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P2",
      "componentType": null
    },
    {
      "id": "G07",
      "title": "换皮肤与交付",
      "scope": "common",
      "procedure": "缺角色/无切片/摘要不符拒绝；合法换肤保持值、行为与布局合同，资源闭包完整；真实美术接受另记",
      "expected": "按操作中的具体断言取证；不适用分项须记录原因。",
      "phase": "P4 / P5",
      "componentType": null
    },
    {
      "id": "T01",
      "title": "Button",
      "scope": "component",
      "procedure": "三种变体；点击、移出释放、禁用、键盘激活；长文案与连续重开",
      "expected": "每次有效激活一次 activate；取消/禁用零事件；三种变体的内容区与命中区正确；重开无重复回调",
      "phase": "P1",
      "componentType": "Button"
    },
    {
      "id": "T02",
      "title": "Switch",
      "scope": "component",
      "procedure": "false→true→false；标签点击；程序赋值；禁用；窄宽两档",
      "expected": "布尔值、轨道和滑块同步；用户每次一次 valueChange，赋值/初始化不回调；滑块不出轨",
      "phase": "P1",
      "componentType": "Switch"
    },
    {
      "id": "T03",
      "title": "CheckBox",
      "scope": "component",
      "procedure": "框与标签点击、重复切换、禁用且已选；标记缺失",
      "expected": "每次仅翻转一次；禁用仍保留选中标记但不可改值；缺必需标记策略阻断",
      "phase": "P1",
      "componentType": "CheckBox"
    },
    {
      "id": "T04",
      "title": "RadioGroup",
      "scope": "component",
      "procedure": "空集合、未选中、三选一、禁用选项、重排、删除已选项",
      "expected": "始终最多一选；同标签不同 ID 不混淆；重排保持 ID；非法 selectedId 被拒绝",
      "phase": "P1",
      "componentType": "RadioGroup"
    },
    {
      "id": "T05",
      "title": "Input",
      "scope": "component",
      "procedure": "中文 IME、英文/emoji、粘贴/选择、密码、只读/禁用、长度边界、失焦与移动键盘",
      "expected": "不截断组合输入；最终字符串和值一致；editEnd 不触发提交；销毁/隐藏后输入 DOM 不残留。真机输入证据单列",
      "phase": "P1",
      "componentType": "Input"
    },
    {
      "id": "T06",
      "title": "Select",
      "scope": "component",
      "procedure": "空集合、placeholder、重复标签、重排、长菜单、屏幕下沿展开、选项禁用与删除",
      "expected": "回调稳定 ID；选择一次即关闭；菜单在可视区域且不被祖先裁掉；外部点击和销毁后无残留；无效引用阻断",
      "phase": "P1",
      "componentType": "Select"
    },
    {
      "id": "T07",
      "title": "Slider",
      "scope": "component",
      "procedure": "min/mid/max、整数及小数步长、非零/负 min、拖动/取消、禁用；max≤min/step≤0/越界值",
      "expected": "值与滑块/填充一致；拖动实时更新，完成一次 commit，取消不 commit；非法配置拒绝，不溢出端点",
      "phase": "P1",
      "componentType": "Slider"
    },
    {
      "id": "T08",
      "title": "ProgressBar",
      "scope": "component",
      "procedure": "0/50/100%、非零 min、两种长度、非法范围与越界值",
      "expected": "映射值正确；零/满进度及边框不变形；不产生用户改值事件；越界不伪装成正常进度",
      "phase": "P1",
      "componentType": "ProgressBar"
    },
    {
      "id": "T09",
      "title": "ScrollView",
      "scope": "component",
      "procedure": "空、刚好容纳、溢出；轮滚/触摸/条块拖动；内容缩短；嵌套控件；三种滚动条策略",
      "expected": "内容与条块同一偏移；裁切外不可命中；收缩后偏移夹紧；不发生双重滚动；点击与拖动正确仲裁",
      "phase": "P1",
      "componentType": "ScrollView"
    },
    {
      "id": "T10",
      "title": "List",
      "scope": "component",
      "procedure": "空/单条/多条、无选择/单选、重排和删除、重复标签、替换已有 itemRecipe、组合滚动",
      "expected": "选择按 ID；数据只实例化一份；条目间距和高度正确；列表不另管滚动；不存在 ID 报错",
      "phase": "P1",
      "componentType": "List"
    },
    {
      "id": "T11",
      "title": "Dialog",
      "scope": "component",
      "procedure": "初始关闭/打开、动作按钮重排、遮罩点击策略、重复关闭、非模态、多个模态、直接销毁",
      "expected": "action 返回 actionId；closed 与 action 分开且不重复；只释放自己的模态占用；无点击穿透或遗留阻塞",
      "phase": "P1",
      "componentType": "Dialog"
    },
    {
      "id": "T12",
      "title": "Tabs",
      "scope": "component",
      "procedure": "空/单页/多页、切换、长标签、重排、禁用页、删除活动页、页内 Input/Slider",
      "expected": "活动页 ID 正确；隐藏页不可交互/持焦；切回保持声明的运行值；重开恢复创作值；悬空内容引用阻断",
      "phase": "P1",
      "componentType": "Tabs"
    },
    {
      "id": "T13",
      "title": "Image",
      "scope": "component",
      "procedure": "宽/高图分别 contain/cover/fill、透明图、更换资源、资源缺失；两个实例共享纹理",
      "expected": "缩放/裁切符合声明；透明区与资源摘要正确；缺件只可编辑占位，不能成功交付；销毁不伤其他实例",
      "phase": "P1",
      "componentType": "Image"
    },
    {
      "id": "T14",
      "title": "Text",
      "scope": "component",
      "procedure": "空、长中文、长英文单词、混排、显式换行、对齐、三种 overflow；缺字体与字体就绪后重排",
      "expected": "文本与测量一致；省略不切坏字符，error 明确失败；不默认缩字掩盖溢出；字体缺失不静默换成不明样式",
      "phase": "P1",
      "componentType": "Text"
    },
    {
      "id": "T15",
      "title": "Container",
      "scope": "component",
      "procedure": "row/column/wrap、间距/边距、子节点重排、允许的 free 区域、隐藏与循环引用",
      "expected": "只有一个排版所有者；flow 不接受冲突手写坐标；free 局部定位可往返；空白不阻断背景交互；循环被拒绝",
      "phase": "P1",
      "componentType": "Container"
    },
    {
      "id": "T16",
      "title": "Panel",
      "scope": "component",
      "procedure": "有/无标题、内容槽、最小尺寸、长标题、加宽加高、嵌套表单、换肤",
      "expected": "九宫格边框与内容区稳定；布局不越界；不自带模态；缺必需底板/切片阻断；标题与内容保存后可重建",
      "phase": "P1",
      "componentType": "Panel"
    }
  ],
  "recipes": [
