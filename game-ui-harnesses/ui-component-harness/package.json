{
  "name": "ai-ui-component-harness",
  "private": true,
  "version": "0.2.0-rc.3",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json && vite build --config vite.browser.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:distribution": "npm run build && node scripts/check-distribution.mjs",
    "self-test": "node scripts/cli.mjs self-test",
    "doctor": "node scripts/cli.mjs doctor",
    "verify": "node scripts/verify.mjs",
    "fixtures": "node scripts/write-fixtures.mjs",
    "motion:fixtures": "node scripts/write-motion-systems.mjs"
  },
  "bin": {
    "ai-ui-component": "scripts/cli.mjs",
    "ai-ui-motion": "scripts/motion-cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./browser": { "types": "./lib/browser.d.ts", "import": "./lib/browser.js" },
    "./browser/standalone": { "types": "./lib/browser.d.ts", "import": "./dist-browser/index.js" },
    "./planning": { "import": "./scripts/layer-planning.mjs" },
    "./render": { "import": "./scripts/layer-render-host.mjs" }
  },
  "files": [
    "lib",
    "dist-browser",
    "scripts/harness-module.mjs",
    "scripts/layer-planning.mjs",
    "scripts/layer-render-host.mjs",
    "scripts/studio-codex-plan.mjs",
    "scripts/studio-layer-render.mjs",
    "scripts/layer-ui-interaction-check.mjs",
    "scripts/cli.mjs",
    "scripts/reference-run.mjs",
    "dist/reference-acceptance.html",
    "dist/layer-plan-check.html",
    "dist/assets",
    "scripts/motion-cli.mjs",
    "scripts/workflow-run.mjs",
    "scripts/workflow-browser.mjs",
    "scripts/legacy-layered-import.mjs",
    "scripts/legacy-layered-case.mjs",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "skill.json",
    "agents",
    "skills",
    "docs/automation.md",
    "docs/assets-intake-v2.md",
    "docs/layer-component.md",
