{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "revision",
    "title",
    "canvas",
    "bindings",
    "rootId",
    "nodes"
  ],
  "properties": {
    "kind": { "const": "ui_panel_document" },
    "version": { "enum": ["0.1", "0.2", "0.3"] },
    "panelBackgrounds": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^background-[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "ui-panel-background-v1#/definitions/asset" }
    },
    "id": { "$ref": "#/definitions/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "maxLength": 200 },
    "canvas": { "enum": ["landscape", "portrait"] },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "sha256"],
      "properties": {
        "sourceKind": { "enum": ["fixture", "imported"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "rootId": { "$ref": "#/definitions/id" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$" },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 24, "maximum": 16384 },
        "height": { "type": "number", "minimum": 24, "maximum": 16384 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 16384 },
        "y": { "type": "number", "minimum": 0, "maximum": 16384 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "childrenMode": { "enum": ["flow", "free"] },
        "direction": { "enum": ["column", "row", "wrap", "grid"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 128 },
        "padding": { "type": "number", "minimum": 0, "maximum": 128 },
        "align": { "enum": ["flex-start", "center", "flex-end", "stretch"] },
        "justify": { "enum": ["flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 16 },
        "cellWidth": { "type": "number", "minimum": 24, "maximum": 16384 },
        "cellHeight": { "type": "number", "minimum": 24, "maximum": 16384 }
      }
    },
    "sizing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "widthMode": { "enum": ["fixed", "fill", "content"] },
        "heightMode": { "enum": ["fixed", "fill", "content"] },
        "minWidth": { "type": "number", "minimum": 24, "maximum": 16384 },
        "minHeight": { "type": "number", "minimum": 24, "maximum": 16384 },
        "maxWidth": { "type": "number", "minimum": 24, "maximum": 16384 },
        "maxHeight": { "type": "number", "minimum": 24, "maximum": 16384 },
        "grow": { "type": "number", "minimum": 0, "maximum": 100 },
        "shrink": { "type": "number", "minimum": 0, "maximum": 100 },
        "alignSelf": { "enum": ["flex-start", "center", "flex-end", "stretch"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "recipeRef", "props", "size", "slots"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "maxLength": 100 },
        "recipeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "props": { "type": "object" },
        "surfaceStyle": { "enum": ["title", "section", "panel"] },
        "surfaceLayer": { "enum": ["frame", "content", "inset"] },
        "surfaceTextInsets": { "type":"object", "additionalProperties":false, "required":["left","right","top","bottom"], "properties": { "left":{"type":"number","minimum":0,"maximum":512}, "right":{"type":"number","minimum":0,"maximum":512}, "top":{"type":"number","minimum":0,"maximum":512}, "bottom":{"type":"number","minimum":0,"maximum":512} } },
        "size": { "$ref": "#/definitions/size" },
        "position": { "$ref": "#/definitions/position" },
        "layout": { "$ref": "#/definitions/layout" },
        "sizing": { "$ref": "#/definitions/sizing" },
        "locked": { "type": "boolean" },
        "slots": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
          "additionalProperties": {
            "type": "array",
            "maxItems": 256,
            "items": { "$ref": "#/definitions/id" }
          }
        }
      }
    }
  }
}
