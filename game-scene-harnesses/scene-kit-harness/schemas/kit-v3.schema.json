{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_scene_kit_v3",
  "type": "object",
  "properties": {
    "format": {
      "const": "ai_scene_kit_v3"
    },
    "kitId": {
      "$ref": "kit.schema.json#/properties/kitId"
    },
    "revision": {
      "$ref": "kit.schema.json#/properties/revision"
    },
    "profile": {
      "$ref": "kit.schema.json#/properties/profile"
    },
    "purpose": {
      "const": "art-candidate"
    },
    "grid": {
      "$ref": "kit.schema.json#/properties/grid"
    },
    "pixelsPerUnit": {
      "$ref": "kit.schema.json#/properties/pixelsPerUnit"
    },
    "files": {
      "$ref": "kit.schema.json#/properties/files"
    },
    "terrainAppearance": {
      "type": "object",
      "properties": {
        "format": {
          "const": "ai_scene_continuous_terrain_appearance_v2"
        },
        "selection": {
          "const": "world-cell-8x4-phase-order-v1"
        },
        "profileSha256": {
          "const": "eea16fad6eb3530f9a9586877bf9c9aace07137d5f893f75a6218eb09a4b51dd"
        },
        "sourceSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "studySha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "body": {
          "$ref": "#/$defs/material"
        },
        "cap": {
          "$ref": "#/$defs/material"
        },
        "visualAcceptance": {
          "const": "not-assessed"
        },
        "tint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        }
      },
      "required": [
        "format",
        "selection",
        "profileSha256",
        "sourceSha256",
        "studySha256",
        "body",
        "cap",
        "visualAcceptance"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "module-catalog.schema.json#/properties/modules/items/properties/source"
        },
        "pixelSize": {
          "$ref": "common.schema.json#/$defs/size"
        }
      },
      "required": [
        "source",
        "pixelSize"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "kitId",
    "revision",
    "profile",
    "purpose",
    "grid",
    "pixelsPerUnit",
    "files",
    "terrainAppearance"
  ],
  "additionalProperties": false
}
