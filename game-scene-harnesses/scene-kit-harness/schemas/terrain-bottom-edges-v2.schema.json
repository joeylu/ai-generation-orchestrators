{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ai_scene_terrain_bottom_edges_v2",
  "type":"object",
  "properties":{
    "format":{"const":"ai_scene_terrain_bottom_edges_v2"},
    "profile":{"const":"native-horizontal-bottom-union-v2"},
    "nativeSizeProfile":{"const":"bounded-native-4m-v1"},
    "renderEnvelopeProfile":{"const":"visible-alpha8-outward16-native-rgba-v1"},
    "junctionProfile":{"enum":["native-bottom-endpoint-underlap-v1","native-bottom-adaptive-coverage-v2"]},
    "bodySupportProfile":{"const":"author-solid-world-body-v1"},
    "thinPlatformTopProfile":{"const":"isolated-flat-platform-top-v1"},
    "sourceBinding":{"type":"object","properties":{
      "materialSourceSha256":{"$ref":"common.schema.json#/$defs/sha256"},
      "surfaceMappingSha256":{"$ref":"common.schema.json#/$defs/sha256"}
    },"required":["materialSourceSha256","surfaceMappingSha256"],"additionalProperties":false},
    "edge":{"$ref":"#/$defs/edge"},
    "leftCorner":{"$ref":"#/$defs/corner"},
    "rightCorner":{"$ref":"#/$defs/corner"}
  },
  "required":["format","profile","nativeSizeProfile","renderEnvelopeProfile","sourceBinding","edge","leftCorner","rightCorner"],
  "additionalProperties":false,
  "$defs":{
    "source":{"type":"object","properties":{
      "path":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.png$"},
      "sha256":{"$ref":"common.schema.json#/$defs/sha256"},
      "byteLength":{"type":"integer","minimum":1,"maximum":16777216}
    },"required":["path","sha256","byteLength"],"additionalProperties":false},
    "pixelSize":{"type":"object","properties":{"width":{"type":"integer","minimum":4,"maximum":4096},"height":{"type":"integer","minimum":4,"maximum":4096}},"required":["width","height"],"additionalProperties":false},
    "scale":{"type":"object","properties":{"numerator":{"type":"integer","minimum":1,"maximum":1048576},"denominator":{"type":"integer","minimum":1,"maximum":1048576}},"required":["numerator","denominator"],"additionalProperties":false},
    "blend":{"type":"object","properties":{"fromY":{"type":"integer","minimum":0,"maximum":4095},"toY":{"type":"integer","minimum":0,"maximum":4095}},"required":["fromY","toY"],"additionalProperties":false},
    "edge":{"type":"object","properties":{
      "source":{"$ref":"#/$defs/source"},"pixelSize":{"$ref":"#/$defs/pixelSize"},"scale":{"$ref":"#/$defs/scale"},
      "boundaryY":{"type":"integer","minimum":0,"maximum":4095},"innerY":{"type":"integer","minimum":1,"maximum":4095},
      "repeatX":{"type":"object","properties":{"from":{"type":"integer","minimum":0,"maximum":4095},"to":{"type":"integer","minimum":2,"maximum":4095}},"required":["from","to"],"additionalProperties":false},
      "inboardBlend":{"$ref":"#/$defs/blend"}
    },"required":["source","pixelSize","scale","boundaryY","innerY","repeatX","inboardBlend"],"additionalProperties":false},
    "corner":{"type":"object","properties":{
      "source":{"$ref":"#/$defs/source"},"pixelSize":{"$ref":"#/$defs/pixelSize"},"scale":{"$ref":"#/$defs/scale"},
      "boundaryY":{"type":"integer","minimum":0,"maximum":4095},"innerY":{"type":"integer","minimum":1,"maximum":4095},
      "boundaryX":{"type":"integer","minimum":0,"maximum":4095},"innerX":{"type":"integer","minimum":1,"maximum":4095},
      "wallStartY":{"type":"integer","minimum":0,"maximum":4095},"stripStartX":{"type":"integer","minimum":0,"maximum":4095},
      "inboardBlend":{"$ref":"#/$defs/blend"}
    },"required":["source","pixelSize","scale","boundaryY","innerY","boundaryX","innerX","wallStartY","stripStartX","inboardBlend"],"additionalProperties":false}
  }
}
