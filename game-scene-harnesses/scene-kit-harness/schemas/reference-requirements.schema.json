{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinate-free reference requirements",
  "type": "object",
  "properties": {
    "format": { "const": "ai_scene_reference_requirements_v1" },
    "requirementsId": { "$ref": "common.schema.json#/$defs/id" },
    "layers": { "type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "properties": {
        "layerId": { "$ref": "common.schema.json#/$defs/id" },
        "kind": { "enum": ["background", "environment", "terrain", "foreground", "atmosphere"] },
        "zIndex": { "type": "integer", "minimum": 0, "maximum": 100 },
        "parallaxX": { "type": "number", "minimum": 0, "maximum": 2 }
      }, "required": ["layerId", "kind", "zIndex", "parallaxX"], "additionalProperties": false
    } },
    "subjects": { "type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "properties": {
        "subjectId": { "$ref": "common.schema.json#/$defs/id" },
        "layerId": { "$ref": "common.schema.json#/$defs/id" },
        "role": { "$ref": "common.schema.json#/$defs/id" },
        "content": { "$ref": "generation-common.schema.json#/$defs/rule" },
        "count": { "type": "object", "properties": { "min": { "type": "integer", "minimum": 0, "maximum": 8 }, "max": { "type": "integer", "minimum": 1, "maximum": 8 } }, "required": ["min", "max"], "additionalProperties": false },
        "placementHint": { "enum": ["left", "right", "center", "wide", "frame-edges", "anywhere"] }
      }, "required": ["subjectId", "layerId", "role", "content", "count", "placementHint"], "additionalProperties": false
    } },
    "compositionNotes": { "type": "array", "maxItems": 8, "items": { "$ref": "generation-common.schema.json#/$defs/rule" } },
    "standards": { "type": "array", "minItems": 7, "maxItems": 7, "items": {
      "type": "object", "properties": {
        "key": { "enum": ["projection", "layer-separation", "frame-completeness", "terrain-readability", "foreground-readability", "style-consistency", "decomposability"] },
        "requirement": { "$ref": "generation-common.schema.json#/$defs/rule" }
      }, "required": ["key", "requirement"], "additionalProperties": false
    } },
    "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "required": ["format", "requirementsId", "layers", "subjects", "compositionNotes", "standards", "sha256"],
  "additionalProperties": false
}
