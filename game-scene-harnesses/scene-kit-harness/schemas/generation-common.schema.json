{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "image": {
      "type": "object",
      "properties": {
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "pixelSize": { "$ref": "common.schema.json#/$defs/size" }
      },
      "required": ["sha256", "byteLength", "pixelSize"],
      "additionalProperties": false
    },
    "text": { "type": "string", "maxLength": 8000 },
    "rule": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
