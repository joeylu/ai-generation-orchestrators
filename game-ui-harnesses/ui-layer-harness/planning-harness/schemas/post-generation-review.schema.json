{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "materialIds",
          "severity",
          "category",
          "observation",
          "suggestedFix",
          "route"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "materialIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "major"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "placement",
              "geometry",
              "missing",
              "unexpected_content",
              "edge_quality",
              "detail_fidelity"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "suggestedFix": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "enum": [
              "placement",
              "postprocess",
              "planning",
              "regenerate",
              "manual_review"
            ]
          }
        }
      }
    }
  }
}
