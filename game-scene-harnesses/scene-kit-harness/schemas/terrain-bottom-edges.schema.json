{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ai_scene_terrain_bottom_edges_v1",
  "type":"object",
  "properties":{
    "format":{"const":"ai_scene_terrain_bottom_edges_v1"},
    "profile":{"const":"native-horizontal-bottom-union-v1"},
    "sourceBinding":{"type":"object","properties":{
      "materialSourceSha256":{"$ref":"common.schema.json#/$defs/sha256"},
      "surfaceMappingSha256":{"$ref":"common.schema.json#/$defs/sha256"}
    },"required":["materialSourceSha256","surfaceMappingSha256"],"additionalProperties":false},
    "edge":{"$ref":"#/$defs/edge"},
    "leftCorner":{"$ref":"#/$defs/corner"},
    "rightCorner":{"$ref":"#/$defs/corner"}
  },
  "required":["format","profile","sourceBinding","edge","leftCorner","rightCorner"],
  "additionalProperties":false,
  "$defs":{
    "source":{"type":"object","properties":{
      "path":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.png$"},
      "sha256":{"$ref":"common.schema.json#/$defs/sha256"},
      "byteLength":{"type":"integer","minimum":1,"maximum":16777216}
    },"required":["path","sha256","byteLength"],"additionalProperties":false},
    "pixelSize":{"type":"object","properties":{"width":{"type":"integer","minimum":4,"maximum":2048},"height":{"type":"integer","minimum":4,"maximum":2048}},"required":["width","height"],"additionalProperties":false},
    "scale":{"type":"object","properties":{"numerator":{"type":"integer","minimum":1,"maximum":1048576},"denominator":{"type":"integer","minimum":1,"maximum":1048576}},"required":["numerator","denominator"],"additionalProperties":false},
    "blend":{"type":"object","properties":{"fromY":{"type":"integer","minimum":0,"maximum":2047},"toY":{"type":"integer","minimum":0,"maximum":2047}},"required":["fromY","toY"],"additionalProperties":false},
    "edge":{"type":"object","properties":{
      "source":{"$ref":"#/$defs/source"},"pixelSize":{"$ref":"#/$defs/pixelSize"},"scale":{"$ref":"#/$defs/scale"},
      "boundaryY":{"type":"integer","minimum":0,"maximum":2047},"innerY":{"type":"integer","minimum":1,"maximum":2046},
      "repeatX":{"type":"object","properties":{"from":{"type":"integer","minimum":0,"maximum":2046},"to":{"type":"integer","minimum":2,"maximum":2048}},"required":["from","to"],"additionalProperties":false},
      "inboardBlend":{"$ref":"#/$defs/blend"}
    },"required":["source","pixelSize","scale","boundaryY","innerY","repeatX","inboardBlend"],"additionalProperties":false},
    "corner":{"type":"object","properties":{
      "source":{"$ref":"#/$defs/source"},"pixelSize":{"$ref":"#/$defs/pixelSize"},"scale":{"$ref":"#/$defs/scale"},
      "boundaryY":{"type":"integer","minimum":0,"maximum":2047},"innerY":{"type":"integer","minimum":1,"maximum":2046},
      "boundaryX":{"type":"integer","minimum":0,"maximum":2047},"innerX":{"type":"integer","minimum":1,"maximum":2046},
      "wallStartY":{"type":"integer","minimum":0,"maximum":2046},"stripStartX":{"type":"integer","minimum":0,"maximum":2047},
      "inboardBlend":{"$ref":"#/$defs/blend"}
    },"required":["source","pixelSize","scale","boundaryY","innerY","boundaryX","innerX","wallStartY","stripStartX","inboardBlend"],"additionalProperties":false}
  }
}
