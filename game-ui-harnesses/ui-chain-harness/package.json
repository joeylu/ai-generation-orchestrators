{
  "name": "ai-ui-chain-template-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline template maintenance tools; the three-stage UI Harness runtime is not implemented.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "templates:validate": "node scripts/templates.mjs validate",
    "templates:build": "node scripts/templates.mjs build",
    "templates:status": "node scripts/templates.mjs status",
    "contracts:validate": "node scripts/contracts.mjs validate",
    "contracts:build": "node scripts/contracts.mjs build",
    "contracts:status": "node scripts/contracts.mjs status",
    "components:check": "node scripts/components.mjs check",
    "components:status": "node scripts/components.mjs status",
    "test:components": "node --test tests/runtime/components.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:render": "node --test tests/browser/*.test.mjs",
    "panel-slicer:render": "node tools/panel-slicer/cli/render.mjs",
    "panel-slicer:check": "node tools/panel-slicer/cli/preview.mjs check",
    "panel-slicer:status": "node tools/panel-slicer/cli/preview.mjs status",
    "panel-slicer:preview": "node tools/panel-slicer/cli/preview.mjs serve",
    "panel-slicer:test": "node --test tools/panel-slicer/tests/*.test.mjs",
    "slicing:check": "node scripts/editor.mjs check --scope slicing",
    "slicing:status": "node scripts/editor.mjs status --scope slicing",
    "slicing:preview": "node scripts/editor.mjs serve --scope slicing",
    "editor:build": "node scripts/editor.mjs build",
    "editor:check": "node scripts/editor.mjs check",
    "editor:status": "node scripts/editor.mjs status",
    "editor": "node scripts/editor.mjs serve",
    "skins:import": "node scripts/skins.mjs import",
    "skins:verify": "node scripts/skins.mjs verify",
    "skins:status": "node scripts/skins.mjs status",
    "skins:preview-status": "node scripts/skins.mjs preview-status",
    "skins:check": "node scripts/skins.mjs check",
    "skins:plan": "node scripts/skins.mjs plan",
    "consumer": "node scripts/consumer.mjs",
    "skins:postprocess": "node scripts/skin-postprocess.mjs",
    "skins:review": "node scripts/skin-review.mjs",
    "assets:workbench": "node scripts/asset-workbench.mjs",
    "skins:workflow": "node scripts/skin-workflow.mjs",
    "skins:quality-risks": "node scripts/skin-quality-risks.mjs",
    "skins:locate": "node scripts/skin-locate.mjs",
    "skins:locate-compare": "node scripts/skin-locate-compare.mjs",
    "skins:localization-trial": "node scripts/skin-localization-trial.mjs",
    "skins:candidates": "node scripts/skin-candidates.mjs",
    "skins:task": "node scripts/skin-task.mjs",
    "skins:batch-execution": "node scripts/skin-batch-execution.mjs",
    "skins:codex": "node scripts/skin-codex.mjs"
  },
  "dependencies": {
    "@pixi/layout": "3.2.0",
    "@pixi/ui": "2.4.1",
    "ajv": "8.20.0",
    "pixi.js": "8.20.1",
    "playwright": "1.63.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "esbuild": "0.25.12"
  }
}
