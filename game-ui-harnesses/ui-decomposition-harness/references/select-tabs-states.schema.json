{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI appearance binding 0.2 Select or Tabs states fragment",
  "description": "Validates one binding.states object. Other component states are governed by their own contracts.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "select"
      ],
      "additionalProperties": false,
      "properties": {
        "select": {
          "$ref": "#/$defs/select"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "tabs": {
          "$ref": "#/$defs/tabs"
        }
      }
    }
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})(?![\\s\\S])",
      "maxLength": 7
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinateSpace",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "coordinateSpace": {
          "enum": [
            "target-component-local",
            "target-item-local",
            "target-popup-local"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "menuHighlights": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "coordinateSpace", "selected", "hover"],
      "properties": {
        "version": {"const": "1.0"},
        "coordinateSpace": {"const": "popup-row-local"},
        "selected": {"$ref": "#/$defs/menuHighlight"},
        "hover": {"$ref": "#/$defs/menuHighlight"}
      }
    },
    "menuHighlight": {
      "type": "object", "additionalProperties": false,
      "required": ["color", "alpha", "insets", "cornerRadius"],
      "properties": {
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "alpha": {"type": "number", "minimum": 0, "maximum": 1},
        "cornerRadius": {"type": "number", "minimum": 0},
        "insets": {
          "type": "object", "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": {"type": "number", "minimum": 0},
            "right": {"type": "number", "minimum": 0},
            "bottom": {"type": "number", "minimum": 0},
            "left": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labelLayout",
        "popupPlacement"
      ],
      "properties": {
        "fieldTextColor": {
          "$ref": "#/$defs/color",
          "description": "Selected value in the field only. Popup options keep style.textColor. Omission preserves legacy behavior."
        },
        "labelLayout": {
          "allOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "properties": {
                "coordinateSpace": {
                  "const": "target-component-local"
                }
              }
            }
          ]
        },
        "popupContentLayout": {
          "allOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "properties": {
                "coordinateSpace": {
                  "const": "target-popup-local"
                }
              }
            }
          ]
        },
        "popupPlacement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinateSpace",
            "anchor",
            "gap"
          ],
          "properties": {
            "coordinateSpace": {
              "const": "target-component-local"
            },
            "anchor": {
              "const": "below-start"
            },
            "gap": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "optionIcons": {
          "$ref": "#/$defs/optionIcons"
        },
        "menuHighlights": {
          "$ref": "#/$defs/menuHighlights"
        }
      },
      "dependentRequired": {
        "optionIcons": [
          "popupContentLayout"
        ],
        "menuHighlights": [
          "popupContentLayout"
        ]
      }
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headerHeight",
        "labelLayout",
        "hitArea"
      ],
      "properties": {
        "activeTextColor": {
          "$ref": "#/$defs/color",
          "description": "Active tab only. Inactive tabs keep style.textColor. Omission preserves legacy behavior."
        },
        "icons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tabId",
              "iconLayout",
              "activeIconLayout"
            ],
            "properties": {
              "tabId": {
                "type": "string",
                "minLength": 1
              },
              "iconLayout": {
                "allOf": [
                  {
                    "$ref": "#/$defs/area"
                  },
                  {
                    "properties": {
                      "coordinateSpace": {
                        "const": "target-item-local"
                      }
                    }
                  }
                ]
              },
              "activeIconLayout": {
                "allOf": [
                  {
                    "$ref": "#/$defs/area"
                  },
                  {
                    "properties": {
                      "coordinateSpace": {
                        "const": "target-item-local"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "headerHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "labelLayout": {
          "allOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "properties": {
                "coordinateSpace": {
                  "const": "target-item-local"
                }
              }
            }
          ]
        },
        "hitArea": {
          "allOf": [
            {
              "$ref": "#/$defs/area"
            },
            {
              "properties": {
                "coordinateSpace": {
                  "const": "target-item-local"
                }
              }
            }
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tabId",
              "layout",
              "labelLayout",
              "hitArea"
            ],
            "properties": {
              "tabId": {
                "type": "string",
                "minLength": 1
              },
              "layout": {
                "allOf": [
                  {
                    "$ref": "#/$defs/area"
                  },
                  {
                    "properties": {
                      "coordinateSpace": {
                        "const": "target-component-local"
                      }
                    }
                  }
                ]
              },
              "labelLayout": {
                "allOf": [
                  {
                    "$ref": "#/$defs/area"
                  },
                  {
                    "properties": {
                      "coordinateSpace": {
                        "const": "target-item-local"
                      }
                    }
                  }
                ]
              },
              "hitArea": {
                "allOf": [
                  {
                    "$ref": "#/$defs/area"
                  },
                  {
                    "properties": {
                      "coordinateSpace": {
                        "const": "target-item-local"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "layoutPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "orientation"
          ],
          "properties": {
            "version": {
              "const": "1.0"
            },
            "orientation": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            }
          }
        }
      },
      "dependentRequired": {
        "layoutPolicy": [
          "items"
        ]
      }
    },
    "rowLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "optionIcons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "coordinateSpace",
        "items"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "coordinateSpace": {
          "const": "popup-row-local"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "optionId",
              "icon",
              "labelLayout"
            ],
            "properties": {
              "optionId": {
                "type": "string",
                "minLength": 1
              },
              "labelLayout": {
                "$ref": "#/$defs/rowLayout"
              },
              "icon": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "layerId",
                      "layout"
                    ],
                    "properties": {
                      "layerId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "layout": {
                        "$ref": "#/$defs/rowLayout"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
