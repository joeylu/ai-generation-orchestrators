{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-frame-animation/decoded-handoff.schema.json",
  "title": "Verified predecoded video handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_source", "probe", "decode", "handoff_sha256"],
  "properties": {
    "schema_version": {"const": "ai_frame_animation_decoded_handoff_v1"},
    "handoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_source": {"$ref": "#/$defs/videoArtifact"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_count", "artifact", "tool"],
      "properties": {
        "operation_count": {"const": 1},
        "artifact": {"$ref": "#/$defs/jsonArtifact"},
        "tool": {"$ref": "#/$defs/toolEvidence"}
      }
    },
    "decode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_count", "policy", "directory", "frame_count", "frames", "tool"],
      "properties": {
        "operation_count": {"const": 1},
        "policy": {"const": "single_lossless_png_decode"},
        "directory": {"$ref": "#/$defs/relativePath"},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "artifact"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "artifact": {"$ref": "#/$defs/pngArtifact"}
            }
          }
        },
        "tool": {"$ref": "#/$defs/toolEvidence"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\\\]+$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "videoArtifact": {
      "allOf": [
        {"$ref": "#/$defs/fingerprint"},
        {"properties": {"media_type": {"const": "video"}}}
      ]
    },
    "jsonArtifact": {
      "allOf": [
        {"$ref": "#/$defs/fingerprint"},
        {"properties": {"media_type": {"const": "application/json"}}}
      ]
    },
    "pngArtifact": {
      "allOf": [
        {"$ref": "#/$defs/fingerprint"},
        {"properties": {"media_type": {"const": "image/png"}}}
      ]
    },
    "toolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+ -]{0,127}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
