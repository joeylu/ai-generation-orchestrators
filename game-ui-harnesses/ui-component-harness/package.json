  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "peerDependencies": { "playwright": "1.63.0" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
