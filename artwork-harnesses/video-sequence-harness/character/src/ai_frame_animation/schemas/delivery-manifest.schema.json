{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-frame-animation/delivery-manifest.schema.json",
  "title": "AI frame animation delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "plan_sha256", "quality_policy", "raw_source", "source_timeline", "semantic_interval", "decode", "requested_atlas_profiles", "gif_requested", "variants", "failures", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "ai_frame_animation_delivery_manifest_v2"},
    "tool_version": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quality_policy": {"enum": ["strict", "best_effort"]},
    "raw_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"const": "video"}
      }
    },
    "source_processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "foreground_source",
        "source_probe",
        "foreground_probe",
        "handoff_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "ai_frame_animation_alpha_source_v1"
        },
        "foreground_source": {
          "$ref": "#/properties/raw_source"
        },
        "source_probe": {
          "type": "object"
        },
        "foreground_probe": {
          "type": "object"
        },
        "handoff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_timeline": {
      "type": "object",
      "required": ["schema_version", "decoded_frame_count", "raw_fps", "raw_duration_seconds", "semantic_duration_seconds", "frame_timestamps_seconds", "timestamps_source", "terminal_policy"]
    },
    "decode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_operation_count", "operation_count", "decoded_frame_count", "input_mode"],
      "properties": {
        "probe_operation_count": {"const": 1},
        "operation_count": {"const": 1},
        "decoded_frame_count": {"type": "integer", "minimum": 1},
        "input_mode": {"enum": ["internal_decode", "verified_decoded_handoff"]},
        "handoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"input_mode": {"const": "verified_decoded_handoff"}}},
          "then": {"required": ["handoff_sha256"]},
          "else": {"not": {"required": ["handoff_sha256"]}}
        }
      ]
    },
    "semantic_interval": {"type": "object", "required": ["schema_version", "continuity", "policy", "start_frame_zero_based", "end_frame_exclusive_zero_based", "native_frame_count", "duration_seconds", "candidates"]},
    "requested_atlas_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["4x4", "8x4", "8x8"]}},
    "gif_requested": {"type": "boolean"},
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atlas_profile", "capacity", "frame_count", "status", "warnings", "manifest"],
        "properties": {
          "atlas_profile": {"enum": ["4x4", "8x4", "8x8"]},
          "capacity": {"enum": [16, 32, 64]},
          "frame_count": {"type": "integer", "minimum": 1, "maximum": 64},
          "status": {"const": "completed"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "manifest": {"type": "object"}
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atlas_profile", "status", "code"],
        "properties": {
          "atlas_profile": {"enum": ["4x4", "8x4", "8x8"]},
          "status": {"const": "failed"},
          "code": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
